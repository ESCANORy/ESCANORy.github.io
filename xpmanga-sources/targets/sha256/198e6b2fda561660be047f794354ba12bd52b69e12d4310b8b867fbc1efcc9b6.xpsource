{"schemaVersion":1,"keyId":"xpmanga-official-root-2026","payload":"{\"packageFormatVersion\":1,\"kind\":\"XPMANGA_SOURCE_PACKAGE_V1\",\"repositoryId\":\"org.xpmanga.sources.official\",\"packageId\":\"org.xpmanga.source.web.s5204dc3e8d3f93c708d4e4bb\",\"sourceId\":\"org.xpmanga.source.web.s5204dc3e8d3f93c708d4e4bb\",\"revision\":1,\"version\":\"1.0.0\",\"publishedAtEpochSeconds\":1785733154,\"changelog\":\"Initial official RocksManga package reusing the existing Madara adapter with the qualified WP-Fire selectors and restricted image host.\",\"descriptor\":{\"displayName\":\"RocksManga\",\"aliases\":[\"Rocks Manga\",\"rocksmanga.com\",\"روكس مانجا\"],\"iconUrl\":null,\"description\":\"تعريف XPSP الرسمي لمصدر RocksManga عبر محرك Madara الحالي وإعداد WP-Fire تصريحي مقيد.\",\"languages\":[\"ar\"],\"contentRatings\":[\"SAFE\"],\"capabilities\":{\"browse\":true,\"search\":true,\"latest\":true,\"popular\":true,\"genres\":true,\"mangaDetails\":true,\"chapters\":true,\"pages\":true,\"filters\":false,\"downloads\":true,\"nsfw\":false,\"auth\":false},\"baseUrl\":\"https://rocksmanga.com\",\"canonicalDomain\":\"rocksmanga.com\",\"allowedDomains\":[\"rocksmanga.com\",\"www.rocksmanga.com\",\"str.rockscans.org\"]},\"compatibility\":{\"minPlatformApi\":2,\"maxPlatformApiExclusive\":3,\"engineId\":\"MADARA_V1\",\"minEngineContract\":1,\"maxEngineContractExclusive\":2},\"runtime\":{\"type\":\"LOCAL_DECLARATIVE\",\"madara\":{\"catalogPaths\":[\"/manga-type/manga/\"],\"searchPathTemplate\":\"/?s={query}&post_type=wp-manga\",\"catalogItemSelectors\":[\".original.card-lg .unit\"],\"titleSelectors\":[\".info > a[href*=/manga/]\"],\"coverSelectors\":[\"a.poster img\"],\"detailTitleSelectors\":[\".manga-detail .info h1\"],\"descriptionSelectors\":[\".manga-detail .description\"],\"authorSelectors\":[\".manga-detail .meta a[href*=/manga-author/]\"],\"genreSelectors\":[\".manga-detail .meta a[href*=/manga-genre/]\"],\"statusSelectors\":[\".manga-detail .info > p\"],\"chapterSelectors\":[\".list-body-hh li.item > a\"],\"pageImageSelectors\":[\"#ch-images img.preload-image\"],\"chapterAjaxSuffixes\":[\"ajax/chapters\"],\"chapterAjaxPath\":null,\"chapterAjaxFields\":{},\"enableCatalogAjaxFallback\":false,\"enableChapterAjaxFallback\":false},\"network\":{\"sessionMode\":\"STATELESS\",\"userAgentPolicy\":\"DESKTOP_COMPATIBLE\",\"refererPolicy\":\"PAGE_URL\"}}}","signatureBase64":"MEQCIBVWG6rjXma9IrQ1jlzR8bE77lGOMDgnLpx5j/K8ytSdAiBprDjewzUnVtu595Sqc6JXDRYn1NR502wi33reoQgQ3A=="}