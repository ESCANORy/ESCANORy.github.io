{"schemaVersion":1,"keyId":"xpmanga-official-root-2026","payload":"{\"packageFormatVersion\":1,\"kind\":\"XPMANGA_SOURCE_PACKAGE_V1\",\"repositoryId\":\"org.xpmanga.sources.official\",\"packageId\":\"org.xpmanga.source.web.sbc1a26b8892521acb93502b9\",\"sourceId\":\"org.xpmanga.source.web.sbc1a26b8892521acb93502b9\",\"revision\":2,\"version\":\"1.0.1\",\"publishedAtEpochSeconds\":1786760796,\"changelog\":\"إصلاح تحميل فصول MangaSpark الديناميكية عبر endpoint Madara الرسمي بعد ثبوت أن HTML الأولي لا يحتوي قائمة الفصول.\",\"descriptor\":{\"displayName\":\"MangaSpark\",\"aliases\":[\"مانجا سبارك\",\"Manga Spark\"],\"iconUrl\":null,\"description\":\"مصدر مانجا عربي يعمل على قالب Madara مع كتالوج وبحث وتفاصيل وفصول وصور قابلة للتعريف تصريحيًا.\",\"languages\":[\"ar\"],\"contentRatings\":[\"SAFE\",\"SUGGESTIVE\"],\"capabilities\":{\"browse\":true,\"search\":true,\"latest\":true,\"popular\":true,\"genres\":true,\"mangaDetails\":true,\"chapters\":true,\"pages\":true,\"filters\":false,\"downloads\":true,\"nsfw\":false,\"auth\":false},\"baseUrl\":\"https://sparkmanga.net\",\"canonicalDomain\":\"sparkmanga.net\",\"allowedDomains\":[\"sparkmanga.net\",\"sparkio.sparkmanga.net\",\"tempsparkio.sparkmanga.net\",\"sparkio.manga-spark.net\"]},\"compatibility\":{\"minPlatformApi\":2,\"maxPlatformApiExclusive\":3,\"engineId\":\"MADARA_V1\",\"minEngineContract\":1,\"maxEngineContractExclusive\":2},\"runtime\":{\"type\":\"LOCAL_DECLARATIVE\",\"madara\":{\"catalogPaths\":[\"/manga/\"],\"searchPathTemplate\":\"/?s={query}&post_type=wp-manga\",\"catalogItemSelectors\":[\".page-item-detail.manga\",\".row.c-tabs-item__content\"],\"titleSelectors\":[\".item-summary .post-title a\",\".tab-summary .post-title a\"],\"coverSelectors\":[\".item-thumb img.img-responsive\",\".tab-thumb img.img-responsive\"],\"detailTitleSelectors\":[\".post-title h1\"],\"descriptionSelectors\":[\".description-summary .summary__content\"],\"authorSelectors\":[],\"genreSelectors\":[\".genres-content a\"],\"statusSelectors\":[\".post-status .post-content_item .summary-content\"],\"chapterSelectors\":[\"li.wp-manga-chapter > a:first-child\"],\"pageImageSelectors\":[\".reading-content img.wp-manga-chapter-img\"],\"chapterAjaxSuffixes\":[],\"chapterAjaxPath\":\"/wp-admin/admin-ajax.php\",\"chapterAjaxFields\":{\"action\":\"manga_get_chapters\",\"manga\":\"{mangaId}\"},\"enableCatalogAjaxFallback\":false,\"enableChapterAjaxFallback\":true,\"maxCatalogPages\":100},\"network\":{\"sessionMode\":\"BROWSER_SESSION\",\"userAgentPolicy\":\"DESKTOP_COMPATIBLE\",\"refererPolicy\":\"PAGE_URL\"}}}","signatureBase64":"MEYCIQDznTiUTvrRlYAxR0YRt4STftCZpAQs8o71MnRHz1RZAAIhAPr8qO969G+GFjEQrE4n7LU6b+t8VQkgxysJk89js931"}