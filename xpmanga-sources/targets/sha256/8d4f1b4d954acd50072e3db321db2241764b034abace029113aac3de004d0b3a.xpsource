{"schemaVersion":1,"keyId":"xpmanga-official-root-2026","payload":"{\"packageFormatVersion\":1,\"kind\":\"XPMANGA_SOURCE_PACKAGE_V1\",\"repositoryId\":\"org.xpmanga.sources.official\",\"packageId\":\"org.xpmanga.source.web.s4ca478a6f94b1cd2f4864626\",\"sourceId\":\"org.xpmanga.source.web.s4ca478a6f94b1cd2f4864626\",\"revision\":1,\"version\":\"1.0.0\",\"publishedAtEpochSeconds\":1786553344,\"changelog\":\"Initial official Manga Lovers package reusing the qualified declarative Madara adapter and restricted S3 image host.\",\"descriptor\":{\"displayName\":\"Manga Lovers\",\"aliases\":[\"MangaLovers\",\"manga-lovers.com\",\"مانجا لوفرز\"],\"iconUrl\":null,\"description\":\"تعريف XPSP الرسمي لمصدر Manga Lovers عبر إعداد Madara التصريحي المؤهل ومضيف الصور المقيد.\",\"languages\":[\"ar\"],\"contentRatings\":[\"SAFE\"],\"capabilities\":{\"browse\":true,\"search\":true,\"latest\":true,\"popular\":true,\"genres\":true,\"mangaDetails\":true,\"chapters\":true,\"pages\":true,\"filters\":false,\"downloads\":true,\"nsfw\":false,\"auth\":false},\"baseUrl\":\"https://manga-lovers.com\",\"canonicalDomain\":\"manga-lovers.com\",\"allowedDomains\":[\"manga-lovers.com\",\"www.manga-lovers.com\",\"amzn-manga-lovers.s3.eu-north-1.amazonaws.com\"]},\"compatibility\":{\"minPlatformApi\":2,\"maxPlatformApiExclusive\":3,\"engineId\":\"MADARA_V1\",\"minEngineContract\":1,\"maxEngineContractExclusive\":2},\"runtime\":{\"type\":\"LOCAL_DECLARATIVE\",\"madara\":{\"catalogPaths\":[\"/manga\"],\"searchPathTemplate\":\"/search?q={query}\",\"catalogItemSelectors\":[\"a.contain-card[href*='/manga/']\"],\"titleSelectors\":[\"h3\"],\"coverSelectors\":[\"img[src*='amzn-manga-lovers.s3.eu-north-1.amazonaws.com']\"],\"detailTitleSelectors\":[\"h1\"],\"descriptionSelectors\":[\"div.text-gray-100.text-sm.leading-relaxed\"],\"authorSelectors\":[\"p:contains(المؤلف:) span.text-gray-200.font-medium\"],\"genreSelectors\":[\"a[href*='/category/']\"],\"statusSelectors\":[\"h1 + div span.text-gray-300\"],\"chapter